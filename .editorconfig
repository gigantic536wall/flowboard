root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.cs]
# Library code in a web API: ConfigureAwait is not needed (no SynchronizationContext).
dotnet_diagnostic.CA2007.severity = none
# Domain exceptions are thrown with a message; the standard constructors are not needed.
dotnet_diagnostic.CA1032.severity = none
# Test method names use underscores to read like sentences.
dotnet_diagnostic.CA1707.severity = none
# Result<T>.Ok(value) is the idiomatic factory for a result type.
dotnet_diagnostic.CA1000.severity = none

[**/Data/Migrations/*.cs]
# Generated by EF Core: not hand-written, so analyzers are not applied.
generated_code = true

[src/Flowboard.Web/Components/Account/**]
# Identity UI scaffolded by the ASP.NET Core template: kept close to the template, so a few
# performance-style rules are not enforced here (logging delegates, concrete field types).
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1859.severity = none
